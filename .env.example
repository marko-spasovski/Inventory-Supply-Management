# Copy to .env and fill in. Never commit .env. Values here are fake placeholders.
# The local launcher (./run-local.sh) needs none of these; it has local development defaults.
# Variables marked (phase N) are introduced by that phase of docs/plans/remediation-plan.md.

# ── PostgreSQL (one server, one database + owner/runtime role per service, ADR 002) ──
NOVO_DB_USER=administrator
NOVO_DB_PASSWORD=change-me-local-only

# ── Auth (ADR 005) ──────────────────────────────────────────────────────────
# Today: shared HS256 secret read by mobile-gateway and notification-service (removed in phase 3).
JWT_SECRET=change-me-at-least-32-characters-long
# (phase 3) ES256 signing key in PEM, and the first admin account.
# AUTH_SIGNING_KEY_PEM_FILE=./secrets/auth-signing-key.pem
# AUTH_REGISTRATION_ENABLED=false
# AUTH_BOOTSTRAP_ADMIN_EMAIL=admin@example.com
# AUTH_BOOTSTRAP_ADMIN_PASSWORD=change-me

# ── Kafka ───────────────────────────────────────────────────────────────────
KAFKA_BROKERS=localhost:9092

# ── mobile-gateway ──────────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:8081,http://localhost:19006

# ── ai-service: optional Azure OpenAI narrative (analysis works without it) ─
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=
AZURE_OPENAI_API_VERSION=2024-12-01-preview

# ── Mobile app (frontend/mobile/.env) ───────────────────────────────────────
# EXPO_PUBLIC_API_URL=http://<your-LAN-ip>:8090
# EXPO_PUBLIC_WS_URL=ws://<your-LAN-ip>:8090/ws
